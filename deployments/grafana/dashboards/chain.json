{
  "id": null,
  "uid": "vyomanaut-chain",
  "title": "Vyomanaut — Whitechain settlement and audit anchoring",
  "description": "On-chain payments and audit anchoring (vyomanaut_chain_* metrics from internal/metrics/chain.go). These are coordinator-side metrics: start the coordinator with scripts/demo/up.sh --expose-metrics and add its address to deployments/observability/targets/microservice.json, exactly as for the main dashboard. Nothing here changes what providers run or see.",
  "tags": [
    "vyomanaut",
    "chain",
    "whitechain"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "USDT deposited by owners",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "VYOMANAUT_PROMETHEUS_DATASOURCE_UID"
      },
      "description": "Test USDT credited to owners' ledgers from on-chain deposits (vyomanaut_chain_deposit_credited_micro_total, micro-units / 1e6).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vyomanaut_chain_deposit_credited_micro_total / 1e6",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
